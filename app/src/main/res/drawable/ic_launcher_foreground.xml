<?xml version="1.0" encoding="utf-8"?>
<!--
     Adaptive-icon foreground: ScreenDock glyph (screen + inbound triangle).
     Geometry mirrors design/icon/glyph.svg. Drawn inside the 66dp safe zone
     (screen rect 30..78 x 34..74 in the 108 viewport); masks crop the rest.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- screen outline, gradient stroke -->
    <path
        android:pathData="M37,34 L71,34 A7,7 0 0 1 78,41 L78,67 A7,7 0 0 1 71,74 L37,74 A7,7 0 0 1 30,67 L30,41 A7,7 0 0 1 37,34 Z"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="24" android:startY="28"
                android:endX="84" android:endY="80">
                <item android:offset="0.0" android:color="#FF7FB3FF" />
                <item android:offset="1.0" android:color="#FFA78BFA" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- inbound triangle, gradient fill -->
    <path android:pathData="M54,44.5 L64.5,63.5 L43.5,63.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="24" android:startY="28"
                android:endX="84" android:endY="80">
                <item android:offset="0.0" android:color="#FF7FB3FF" />
                <item android:offset="1.0" android:color="#FFA78BFA" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
