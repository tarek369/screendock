<?xml version="1.0" encoding="utf-8"?>
<!-- AirPlay video needs plain http in two cases: UxPlay's loopback HLS proxy (AirPlay 1 / YouTube) and
     AirPlay Video V2 URLs served by the sender itself on the LAN (http://<mac-ip>:<port>/...).
     Android's network-security-config cannot express RFC1918 / link-local CIDR ranges, so cleartext
     is permitted here and the app narrows it to local hosts in code (VideoSource.isAllowed, applied
     before any video URL reaches the player). The app makes no other http requests. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
