<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same exclusions for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="airplay_key.pem" />
        <exclude domain="file" path="datastore/airplay_local_state.preferences_pb" />
        <exclude domain="sharedpref" path="screendock_service.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="airplay_key.pem" />
        <exclude domain="file" path="datastore/airplay_local_state.preferences_pb" />
        <exclude domain="sharedpref" path="screendock_service.xml" />
    </device-transfer>
</data-extraction-rules>
