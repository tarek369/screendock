    <!-- Onboarding -->
    <string name="onb_skip">Skip</string>
    <string name="onb_next">Next</string>
    <string name="onb_done">Get started</string>
    <string name="onb1_title">Same Wi-Fi, ideally 5 GHz</string>
    <string name="onb1_body">Your Apple device and this one must be on the same Wi-Fi network. A 5 GHz network gives the sharpest, smoothest picture.</string>
    <string name="onb1_tip">Guest networks and some VPNs block device discovery.</string>
    <string name="onb2_title">Open Screen Mirroring</string>
    <string name="onb2_body">On iPhone or iPad, swipe down for Control Center and tap Screen Mirroring. On a Mac, open Control Center in the menu bar and choose Screen Mirroring. Then pick “%1$s”.</string>
    <string name="onb2_tip">Music and YouTube also work: tap the AirPlay icon in the app and choose this device.</string>
    <string name="onb3_title">Stay reachable</string>
    <string name="onb3_body">Android may put the receiver to sleep when the app is in the background. Exempt ScreenDock from battery optimization so senders can always find it.</string>
