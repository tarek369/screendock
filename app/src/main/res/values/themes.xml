<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark-first theme: the receiver spends most of its time showing a dark idle screen. -->
    <style name="Theme.Airplay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Launch splash (androidx.core:core-splashscreen; system splash on 31+,
         compat windowBackground splash below). Dark canvas + brand glyph. -->
    <style name="Theme.Airplay.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#07090D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Airplay</item>
    </style>
</resources>
