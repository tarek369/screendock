# UxPlay is VENDORED (not a submodule): the app patches lib/raop.c and
# lib/raop_handlers.h for the receiver->sender touch event channel.
[submodule "app/src/main/cpp/third_party/libplist"]
	path = app/src/main/cpp/third_party/libplist
	url = https://github.com/libimobiledevice/libplist.git
[submodule "app/src/main/cpp/third_party/openssl-cmake"]
	path = app/src/main/cpp/third_party/openssl-cmake
	url = https://github.com/viaduck/openssl-cmake.git
[submodule "app/src/main/cpp/third_party/alac"]
	path = app/src/main/cpp/third_party/alac
	url = https://github.com/macosforge/alac.git
